# ===================================================
# GROWIX Environment Variables Template (.env.example)
# ===================================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Auth.js / NextAuth Security Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="your_random_32_byte_auth_secret_here"

# Application Base URL
APP_URL="https://growix.belalkaram.dev"

# Cloudflare R2 Object Storage (Private Bucket)
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="growix"
R2_REGION="auto"
R2_CUSTOM_DOMAIN="https://files.growix.belalkaram.dev"

# Cloudflare Turnstile CAPTCHA (Human Verification)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Payment Webhook Authorization Token (Generate with: openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET="your_payment_webhook_secret_here"

# Meta Pixel (Optional)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="123456789012345"

# Telegram Bot (Optional server-level fallback)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-1001234567890"
